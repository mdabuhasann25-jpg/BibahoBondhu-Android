rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      // Signed-in members can view only published profile documents.
      // Directly fetch your own profile even when hidden; public directory only lists visible profiles.
      allow get: if request.auth != null
                 && (request.auth.uid == uid || resource.data.visible == true);
      allow list: if request.auth != null
                  && resource.data.visible == true;

      // A member can create or update only their own profile.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'gender', 'age', 'district',
          'education', 'job', 'about', 'visible', 'online', 'lastSeen'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'gender', 'age', 'district',
          'education', 'job', 'about', 'visible', 'online', 'lastSeen'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.gender in ['পাত্র', 'পাত্রী']
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 100
        && request.resource.data.district is string
        && request.resource.data.district.size() >= 1
        && request.resource.data.district.size() <= 100
        && request.resource.data.education is string
        && request.resource.data.education.size() <= 200
        && request.resource.data.job is string
        && request.resource.data.job.size() <= 200
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 1500
        && request.resource.data.visible is bool
        && request.resource.data.online is bool
        && request.resource.data.lastSeen is timestamp;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // No other collections are readable or writable by clients by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
